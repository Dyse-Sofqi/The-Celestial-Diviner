<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 迁移到 .NET Framework 4.8：Win10 1903+ / Win11 系统内置，零安装部署，
         发布体积从自包含 147MB 降至约 2MB。WPF/WinForms 的 PerMonitorV2
         高分屏适配由 app.manifest 声明，行为不变。 -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标 NotifyIcon 需要 WinForms / System.Drawing -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TheCelestialDiviner</RootNamespace>
    <AssemblyName>TheCelestialDiviner</AssemblyName>
    <!-- 管理员权限 + PerMonitorV2 DPI 声明 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.2.1</Version>
    <FileVersion>1.2.1.0</FileVersion>
    <AssemblyTitle>衍天高手</AssemblyTitle>
    <Product>衍天高手 (The Celestial Diviner)</Product>
    <Description>键盘 / 鼠标连发工具（全局钩子 + SendInput，.NET Framework 4.8）</Description>
    <DebugType>embedded</DebugType>
    <!-- System.Text.Json 依赖链在 net48 需要绑定重定向 -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <!-- 全局开关提示语音（内嵌资源，SoundCueService 播放） -->
  <ItemGroup>
    <Resource Include="Resources\Sounds\*.wav" />
  </ItemGroup>

  <!-- DD 驱动模式依赖：官方 DD 虚拟驱动 x64 DLL（原生库，无法内嵌单文件，随目录分发）。
       文件缺失时 DD 模式不可用（界面自动回退普通模式并提示）。 -->
  <ItemGroup>
    <None Include="..\..\drivers\dd63330.dll" Condition="Exists('..\..\drivers\dd63330.dll')">
      <Link>dd63330.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!-- UseWindowsForms 会注入 System.Drawing / System.Windows.Forms 全局 using，
       与 WPF 的 Brush / Application 等类型名冲突：显式移除，需要处用别名引用。 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
