<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 迁移到 .NET Framework 4.8：Win10 1903+ / Win11 系统内置，零安装部署，
         发布体积从自包含 147MB 降至约 2MB。WPF/WinForms 的 PerMonitorV2
         高分屏适配由 app.manifest 声明，行为不变。 -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标 NotifyIcon 需要 WinForms / System.Drawing -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TheCelestialDiviner</RootNamespace>
    <AssemblyName>TheCelestialDiviner</AssemblyName>
    <!-- 管理员权限 + PerMonitorV2 DPI 声明 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.7.2</Version>
    <FileVersion>1.7.2.0</FileVersion>
    <AssemblyTitle>衍天高手</AssemblyTitle>
    <Product>衍天高手 (The Celestial Diviner)</Product>
    <Description>键盘 / 鼠标连发工具（全局钩子 + SendInput，.NET Framework 4.8）</Description>
    <DebugType>embedded</DebugType>
    <!-- System.Text.Json 依赖链在 net48 需要绑定重定向 -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- NoticeService 公告远端检查（net48 不默认引用 in-box 的 HttpClient 程序集） -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <!-- 全局开关提示语音（内嵌资源，SoundCueService 播放）：
       启动 / 停止 / 衍天高手启动（“成为衍天高手”激活时替代启动音） -->
  <ItemGroup>
    <Resource Include="Resources\Sounds\*.mp3" />
  </ItemGroup>

  <!-- 注释区公告（仓库根目录 Notice.md）：内嵌为兜底默认内容，
       同一文件同步托管于 Gitee（Constants.NoticeRemoteUrl），启动时查询更新 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Notice.md" Link="Notice.md" LogicalName="TheCelestialDiviner.Notice.md" />
  </ItemGroup>

  <!-- DD 驱动模式依赖：官方 DD 虚拟驱动 x64 DLL（原生库，无法内嵌单文件，随目录分发）。
       文件缺失时 DD 模式不可用（界面自动回退普通模式并提示），亦可自动从官方发布渠道获取
       （见 DdDriverService.StartAutoFetch）。dd63330.sys 为 DLL 内嵌的内核驱动（本文件为完整签名副本）：
       DD 自身每次运行会释放驱动到 %TEMP% 并注册服务，但该安装例程受安全软件
       干扰 / 旧服务"标记删除"未完成时会间歇性失败并弹"驱动安装错误"模态框；
       程序在 DD_btn 前自行预置服务以绕开（见 DdDriverService.EnsureKernelService）。
       7zr.exe 为 7-Zip 独立精简版（LGPL，仅解 .7z）：自动获取时解压官方发布包用。 -->
  <ItemGroup>
    <None Include="..\..\drivers\dd63330.dll" Condition="Exists('..\..\drivers\dd63330.dll')">
      <Link>dd63330.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="..\..\drivers\dd63330.sys" Condition="Exists('..\..\drivers\dd63330.sys')">
      <Link>dd63330.sys</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="..\..\drivers\7zr.exe">
      <Link>7zr.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!-- UseWindowsForms 会注入 System.Drawing / System.Windows.Forms 全局 using，
       与 WPF 的 Brush / Application 等类型名冲突：显式移除，需要处用别名引用。 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
