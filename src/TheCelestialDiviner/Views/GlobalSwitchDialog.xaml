<Window x:Class="TheCelestialDiviner.Views.GlobalSwitchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置全局开关键" Width="440" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ThemeBg}">
    <StackPanel Margin="16">
        <TextBlock Text="当前热键：" Foreground="{DynamicResource ThemeFg}" Margin="0,0,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="KeyBox" IsReadOnly="True" Text="未设置" Padding="4,3"
                     Background="{DynamicResource ThemePanel}"/>
            <Button x:Name="RecordButton" Grid.Column="1" Content="录制" Padding="10,3"
                    Margin="8,0,0,0" Click="OnRecordClick"/>
            <Button Grid.Column="2" Content="清除" Padding="10,3" Margin="8,0,0,0" Click="OnClearClick"/>
        </Grid>
        <TextBlock x:Name="HintText" Text="录制后按下的键盘按键将成为全局开关键（不能与已注册方案的输入源相同）。"
                   FontSize="11" TextWrapping="Wrap" Opacity="0.7"
                   Foreground="{DynamicResource ThemeFg}" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Padding="10,4" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="确认" Padding="10,4" IsDefault="True" Click="OnConfirmClick"/>
        </StackPanel>
    </StackPanel>
</Window>
