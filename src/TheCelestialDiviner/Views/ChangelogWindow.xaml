<Window x:Class="TheCelestialDiviner.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更新日志" Width="700" Height="620" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False" Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeFg}" FontSize="12"
        UseLayoutRounding="True">
    <!-- 更新日志：展示内嵌 CHANGELOG.md 的全部历史版本（按版本倒序，最新在上）。
         内容由 code-behind 按 Markdown 的 # / ## / ### / 列表 逐行构建 FlowDocument，
         支持选中复制；可调整窗口大小以适配长条目。 -->
    <Border Padding="18,14,18,12">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="Subtitle" TextWrapping="Wrap" Opacity="0.75"
                       Margin="0,0,0,10"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="关闭" Width="78" Height="28"
                        Style="{StaticResource IconButtonStyle}" Click="OnCloseClick"/>
            </StackPanel>
            <!-- 单列滚动（ColumnWidth 在 code-behind 设为正无穷，否则 FlowDocument 默认分栏） -->
            <FlowDocumentScrollViewer x:Name="Viewer" IsToolBarVisible="False"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="Transparent" Padding="0"/>
        </DockPanel>
    </Border>
</Window>
