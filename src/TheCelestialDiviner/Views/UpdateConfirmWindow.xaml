<Window x:Class="TheCelestialDiviner.Views.UpdateConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新 — 衍天高手" Width="600" Height="560" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False" Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeFg}" FontSize="12"
        UseLayoutRounding="True">
    <!-- 更新确认框（检查更新 / 底栏「有更新」共用）：版本号 + 发布说明按 Markdown 渲染
         （行内 **粗体** / `代码` / [链接](url) 与更新日志窗口同源解析），取代旧 Win32
         MessageBox——消息框渲染不了任何格式，发布说明的 **加粗** 标记只能原样显示。
         说明全文可滚动查看（旧版截断到 600 字符）；Enter = 立即更新，Esc = 取消。 -->
    <Border Padding="18,14,18,12">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" TextWrapping="Wrap"/>
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,10"
                       Text="确认后程序将自动下载更新包并重启完成安装。"/>
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4"
                       Text="—— 更新日志 ——"/>
            <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Opacity="0.75" Margin="0,10,0,0"
                       Text="（完整历史更新见「选项 → 更新日志」）"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="取消" Width="78" Height="28" Margin="0,0,8,0" IsCancel="True"
                        Style="{StaticResource IconButtonStyle}"/>
                <Button Content="立即更新" Width="96" Height="28" IsDefault="True" Click="OnConfirmClick"
                        Style="{StaticResource IconButtonStyle}"/>
            </StackPanel>
            <!-- 单列滚动（ColumnWidth 在 code-behind 设为正无穷，否则 FlowDocument 默认分栏） -->
            <FlowDocumentScrollViewer x:Name="Viewer" IsToolBarVisible="False"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="Transparent" Padding="0"/>
        </DockPanel>
    </Border>
</Window>
