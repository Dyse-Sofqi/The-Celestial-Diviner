<Window x:Class="TheCelestialDiviner.Views.SchemeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置方案" Width="560" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ThemeBg}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 已绑定目标键表格 -->
        <DataGrid x:Name="TargetsGrid" Grid.Row="1" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" SelectionMode="Single"
                  Background="Transparent" BorderBrush="{DynamicResource ThemeBorder}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="目标键" Binding="{Binding TargetName}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="模式" Binding="{Binding ModeName}" IsReadOnly="True" Width="80"/>
                <DataGridTemplateColumn Header="间隔(ms)" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="2" Padding="2,1"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTemplateColumn Header="操作" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="删除" Padding="4,0" FontSize="11"
                                    Click="OnDeleteTargetClick"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 添加目标键表单 -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="3">
            <StackPanel x:Name="AddFormPanel" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="目标键：" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource ThemeFg}"/>
                    <TextBox x:Name="RecordedTextBox" Grid.Column="1" IsReadOnly="True"
                             Text="点击“录制”后按下键盘或鼠标按键" Padding="4,3"
                             Background="{DynamicResource ThemePanel}"/>
                    <Button x:Name="RecordButton" Grid.Column="2" Content="录制" Padding="10,3"
                            Margin="6,0,0,0" Click="OnRecordClick"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="模式：" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource ThemeFg}"/>
                    <ComboBox x:Name="ModeCombo" Width="100" SelectedIndex="0">
                        <ComboBoxItem Content="开关 (Toggle)"/>
                        <ComboBoxItem Content="按压 (Hold)"/>
                    </ComboBox>
                    <TextBlock Text="间隔(ms)：" VerticalAlignment="Center" Margin="14,0,6,0"
                               Foreground="{DynamicResource ThemeFg}"/>
                    <TextBox x:Name="IntervalBox" Width="60" Text="5" Padding="4,3"/>
                    <!-- 实验功能：附带修饰键（Ctrl/Shift/Alt）。注入顺序：修饰按下 → 目标点击 → 修饰抬起。 -->
                    <TextBlock Text="附带修饰键（实验）：" VerticalAlignment="Center" Margin="14,0,6,0"
                               Foreground="{DynamicResource ThemeFg}"
                               ToolTip="连发时自动附带修饰键（注入修饰按下→目标点击→修饰抬起）。注意：修饰键属键盘事件，在剑网三等过滤注入键盘的游戏中可能不生效，请实测。"/>
                    <CheckBox x:Name="ModCtrlBox" Content="Ctrl" VerticalAlignment="Center" Margin="0,0,6,0"
                              Foreground="{DynamicResource ThemeFg}"/>
                    <CheckBox x:Name="ModShiftBox" Content="Shift" VerticalAlignment="Center" Margin="0,0,6,0"
                              Foreground="{DynamicResource ThemeFg}"/>
                    <CheckBox x:Name="ModAltBox" Content="Alt" VerticalAlignment="Center"
                              Foreground="{DynamicResource ThemeFg}"/>
                </StackPanel>
                <Button Content="确认添加" Padding="10,3" HorizontalAlignment="Right"
                        Margin="0,8,0,0" Click="OnConfirmAddClick"/>
            </StackPanel>
        </Border>

        <!-- 添加按钮 -->
        <Button x:Name="AddButton" Grid.Row="3" Content="+ 添加" Padding="10,4"
                HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnAddClick"/>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="清空所有" Padding="10,4" Margin="0,0,8,0" Click="OnClearAllClick"/>
            <Button Content="取消" Padding="10,4" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="确认" Padding="10,4" IsDefault="True" Click="OnConfirmClick"/>
        </StackPanel>
    </Grid>
</Window>
