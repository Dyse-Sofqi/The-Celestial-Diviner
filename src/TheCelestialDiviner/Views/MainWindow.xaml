<Window x:Class="TheCelestialDiviner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:TheCelestialDiviner.Helpers"
        Title="衍天高手 The Celestial Diviner v1.5"
        Width="1000" Height="620" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBg}"
        Closing="OnClosing">

    <Window.Resources>
        <conv:BoolToDisabledOpacityConverter x:Key="BoolToOpacity"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>

        <!-- lucide eye / eye-off 图标（ISC 许可，lucide-static v0.544）。
             必须声明为 Geometry 类型：Setter 的 StaticResource 不走 TypeConverter，
             sys:String 会导致 Path.Data 类型不匹配异常 → 渲染管线反复异常 → 栈溢出闪退。 -->
        <Geometry x:Key="EyeIconPath">M2.062,12.348 A1,1 0 0,1 2.062,11.652 A10.75,10.75 0 0,1 21.938,11.652 A1,1 0 0,1 21.938,12.348 A10.75,10.75 0 0,1 2.062,12.348 M12,15 A3,3 0 1,0 12,9 A3,3 0 0,0 12,15 Z</Geometry>
        <Geometry x:Key="EyeOffIconPath">M10.733,5.076 A10.744,10.744 0 0,1 21.938,11.651 A1,1 0 0,1 21.938,12.347 A10.747,10.747 0 0,1 20.494,14.837 M14.084,14.158 A3,3 0 0,1 9.842,9.916 M17.479,17.499 A10.75,10.75 0 0,1 2.062,12.348 A1,1 0 0,1 2.062,11.652 A10.75,10.75 0 0,1 6.508,6.509 M2,2 L22,22</Geometry>

        <!-- 输入源控件模板：图标 + 名称 + 目标键小字；占位空白透明 -->
        <DataTemplate x:Key="SourceButtonTemplate">
            <Border x:Name="Root"
                    Background="{Binding Background}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Margin="2"
                    Opacity="{Binding GloballyDimmed, Converter={StaticResource BoolToOpacity}}">
                <Border.InputBindings>
                    <!-- 左键单击：选择态 → 录入该键；非选择态 → 无操作 -->
                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SourceClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <!-- 键位字符统一字号并居中（不做逐键缩放，保证整版观感一致） -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="IconLabel" Text="{Binding Icon}" FontSize="9" HorizontalAlignment="Center"
                               Foreground="{Binding Foreground}"
                               Visibility="{Binding Icon, Converter={StaticResource EmptyToCollapsed}}"/>
                    <TextBlock x:Name="NameLabel" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{Binding Foreground}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSpacer}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="Transparent"/>
                    <Setter TargetName="Root" Property="BorderBrush" Value="Transparent"/>
                    <Setter TargetName="Root" Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
                <!-- 全局总开关键：主题紫高亮（改键后自动刷新） -->
                <DataTrigger Binding="{Binding IsMasterKey}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                    <Setter TargetName="Root" Property="BorderBrush" Value="#6D47D0"/>
                    <Setter TargetName="IconLabel" Property="Foreground" Value="White"/>
                    <Setter TargetName="NameLabel" Property="Foreground" Value="White"/>
                </DataTrigger>
                <!-- 键位录入选择态：全部图块半透明 + 手型光标 -->
                <DataTrigger Binding="{Binding DataContext.PickingActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                    <Setter TargetName="Root" Property="Cursor" Value="Hand"/>
                </DataTrigger>
                <!-- 选择态 + 悬停：恢复不透明并高亮边框，暗示可点击录入 -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.PickingActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.Setters>
                        <Setter TargetName="Root" Property="Opacity" Value="1"/>
                        <Setter TargetName="Root" Property="BorderBrush" Value="#8A5CF5"/>
                        <Setter TargetName="Root" Property="Cursor" Value="Hand"/>
                    </MultiDataTrigger.Setters>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 方案面板模式标签（选中 = 紫底白字，主题色） -->
        <Style x:Key="ModeTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeFg}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBg" Background="{DynamicResource TabIdleBg}" CornerRadius="3" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="0,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 方案档位按钮（①②③）：继承主题紫选中色，扩大内边距呈正方形 -->
        <Style x:Key="ProfileTabStyle" TargetType="RadioButton" BasedOn="{StaticResource ModeTabStyle}">
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== 全局开关横幅（常驻：关闭=金色 / 开启=主题紫）===== -->
        <Border DockPanel.Dock="Top" Height="32">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AccentGold}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GloballyEnabled}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#1F1F1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Text="⏸按键关闭">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GloballyEnabled}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Text="▶按键开启">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- 默认值必须放 Style Setter：本地 Visibility 优先级高于触发器，会压住 Visible -->
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Foreground" Value="#1F1F1F"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GloballyEnabled}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ===== 底部控制栏（36px）===== -->
        <Border DockPanel.Dock="Bottom" Height="36" Background="{DynamicResource ThemePanel}">
            <DockPanel Margin="10,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding HintText}"
                           Foreground="{DynamicResource ThemeFg}" Opacity="0.6"
                           FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="键盘注入：" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeFg}" FontSize="11"/>
                    <ComboBox x:Name="KeyboardModeBox" Width="130" Margin="0,0,10,0"
                              FontSize="11"
                              ToolTip="游戏内键盘连发不生效时逐个尝试：扫描码模式 → 消息模式 → DD 驱动模式。消息模式仅游戏在前台时有效；DD 驱动模式为物理级注入（需 dd63330.dll + 管理员权限）">
                        <ComboBoxItem Content="普通（SendInput）"/>
                        <ComboBoxItem Content="扫描码（DirectInput）"/>
                        <ComboBoxItem Content="消息（PostMessage）"/>
                        <ComboBoxItem Content="DD 驱动（物理级）"/>
                    </ComboBox>
                    <Button Content="导入配置" Style="{StaticResource IconButtonStyle}"
                            Padding="8,3" Margin="0,0,8,0" Command="{Binding ImportCommand}"/>
                    <Button Content="导出配置" Style="{StaticResource IconButtonStyle}"
                            Padding="8,3" Margin="0,0,8,0" Command="{Binding ExportCommand}"/>
                    <!-- 方案档位切换（①②③ 各存一套按键方案；选中=蓝底白字，随切换实时落盘）。
                         选中态由 code-behind 随 VM.ActiveProfile 同步（避开 RadioButton 组内互斥取消选中
                         破坏绑定的 WPF 已知问题），点击经 Checked 事件回写 VM。 -->
                    <TextBlock Text="方案" VerticalAlignment="Center" Margin="4,0,6,0"
                               Foreground="{DynamicResource ThemeFg}" FontSize="11"/>
                    <RadioButton x:Name="Profile1Button" Content="①" GroupName="SchemeProfile" Tag="0"
                                 Checked="OnProfileChecked" Style="{StaticResource ProfileTabStyle}"
                                 ToolTip="方案①（默认）"/>
                    <RadioButton x:Name="Profile2Button" Content="②" GroupName="SchemeProfile" Tag="1"
                                 Checked="OnProfileChecked" Style="{StaticResource ProfileTabStyle}"
                                 ToolTip="方案②"/>
                    <RadioButton x:Name="Profile3Button" Content="③" GroupName="SchemeProfile" Tag="2"
                                 Checked="OnProfileChecked" Style="{StaticResource ProfileTabStyle}"
                                 ToolTip="方案③"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 键鼠视图（左：鼠标 / 键盘 + 日志）+ 方案面板（右）：自适应填充 ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- 日志面板：常驻展开 8 行（行高 18px）；仅占列 0，避让右侧方案面板 -->
                <RowDefinition Height="144"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左列：鼠标键栏 + 键盘视图（同一列 → 等宽）-->
            <DockPanel Grid.Column="0" Grid.Row="0" Margin="10,4,6,4">
                <!-- 鼠标键栏（全宽铺满与键盘一致；压缩高度给键盘区让出空间）-->
                <Border x:Name="MouseArea" DockPanel.Dock="Top" Height="48" Padding="0,4" Margin="0,0,0,4">
                    <ItemsControl ItemsSource="{Binding MouseButtons}"
                                  ItemTemplate="{StaticResource SourceButtonTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>

                <!-- 键盘区：左列主键区+导航簇（74 单位），右列小键盘（16 单位）。
                     左列行内 主键区 60u | 0.25u | 导航簇 12u | 0.25u —— 数字区与导航簇的间隔和字母区与导航簇等宽。
                     禁用纵向滚动：内容高度经布局保证可容纳（窗口 MinHeight 下限），不出现滚动轴 -->
                <Grid x:Name="KeyboardArea" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74*"/>
                        <ColumnDefinition Width="16*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding KeyboardRows}">
                            <ItemsControl.ItemsPanel>
                                <!-- 6 行等分填满可用高度（键盘区铺满到最大，不随内容收缩） -->
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="6" Columns="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 键盘行：按真实键宽单位比例排列（KeyboardRowPanel + Units 附加属性） -->
                                    <ItemsControl ItemsSource="{Binding}"
                                                  ItemTemplate="{StaticResource SourceButtonTemplate}"
                                                  Margin="0,2">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="conv:KeyboardRowPanel.Units" Value="{Binding WidthUnits}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <conv:KeyboardRowPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 右列：小键盘（6 行 4 列网格；行 0 为功能键行留空，+ 与 ENT 竖向两格、N0 双倍宽） -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding NumpadKeys}"
                                  ItemTemplate="{StaticResource SourceButtonTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Row" Value="{Binding Row}"/>
                                <Setter Property="Grid.Column" Value="{Binding Column}"/>
                                <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}"/>
                                <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>
            </DockPanel>

            <!-- 日志面板（常驻展开；新日志自动滚动到最新；仅占左列，避让方案面板）-->
            <Border Grid.Column="0" Grid.Row="1" Margin="10,0,6,4"
                    Background="{DynamicResource ThemePanel}" ClipToBounds="True">
                <ListBox x:Name="LogList" ItemsSource="{Binding Logs}"
                         FontSize="11" BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource ThemeFg}"
                         TextBlock.LineHeight="16" TextBlock.LineStackingStrategy="BlockLineHeight"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="18"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="IsTabStop" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- 右列：连发键方案面板（全局开关热键 → 连发间隔 → 模式标签 → 添加 → 方案列表）-->
            <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Width="262" Margin="0,4,10,4"
                    Background="{DynamicResource ThemePanel}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                    CornerRadius="4" Padding="10,8">
                <DockPanel>
                    <!-- 全局开关热键 + 语音音量（同一行，音量在热键后面） -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="全局开关热键" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource ThemeFg}"/>
                        <Button Margin="4,0,0,0" Padding="4,3"
                                Command="{Binding SetMasterKeyPickingCommand}"
                                ToolTip="点击修改总开关键（与“添加连发键”相同的录入方式，默认 F9）">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <!-- 用户指定：热键按钮黑色底（白字，IconButtonStyle 默认前景即白 / 浅主题下也清晰） -->
                                    <Setter Property="Background" Value="{DynamicResource HotkeyBg}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#333333"/>
                                    <Setter Property="Content" Value="{Binding MasterKeyText}"/>
                                    <Setter Property="Background" Value="#000000"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#333333"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PickingKind}" Value="SetMasterKey">
                                            <Setter Property="Content" Value="录入中…"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PickingKind}" Value="AddScheme">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="音量：" VerticalAlignment="Center" FontSize="11"
                                   Margin="8,0,0,0" Foreground="{DynamicResource ThemeFg}"/>
                        <Slider x:Name="SoundVolumeSlider" Width="46" Margin="0,0,4,0"
                                Minimum="0" Maximum="100" Value="{Binding SoundVolume}"
                                TickFrequency="10" TickPlacement="None" IsSnapToTickEnabled="False"
                                ToolTip="总开关提示语音音量（0 = 静音）"/>
                        <TextBlock Text="{Binding SoundVolume, StringFormat={}{0:0}%}"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource ThemeFg}" Opacity="0.8"/>
                        <!-- 全局键位可视化总开关（lucide eye / eye-off，样式同行内开关；
                             关闭时仅整体禁用悬浮层显示，各键位开关状态保留，恢复后延续） -->
                        <Button Margin="6,0,0,0" Width="22" Height="20" Padding="0"
                                Command="{Binding ToggleGlobalVisualCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="键位可视化总开关：关闭时全部键位暂停显示（各键位开关状态保留，重新开启后延续）">
                            <Grid Cursor="Hand" Background="Transparent">
                                <Path Stroke="{DynamicResource ThemeFg}"
                                      StrokeThickness="1.8" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="15" Height="15" Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource EyeIconPath}"/>
                                            <Setter Property="Opacity" Value="0.85"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GlobalVisualEnabled}" Value="False">
                                                    <Setter Property="Data" Value="{StaticResource EyeOffIconPath}"/>
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- 模式切换标签 -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeBg}"
                            CornerRadius="4" Padding="2" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton GroupName="SchemeMode" Content="开关模式" Tag="Toggle"
                                         IsChecked="True" Checked="OnModeTabChecked"
                                         Style="{StaticResource ModeTabStyle}"/>
                            <RadioButton Grid.Column="1" GroupName="SchemeMode" Content="按压模式" Tag="Hold"
                                         Checked="OnModeTabChecked"
                                         Style="{StaticResource ModeTabStyle}"/>
                        </Grid>
                    </Border>

                    <!-- 开关模式分区子标签（常规开关 / 轮转开关 / 双宏开关；仅开关模式显示）-->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeBg}"
                            CornerRadius="4" Padding="2" Margin="0,0,0,8"
                            Visibility="{Binding SectionTabsVisible}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton GroupName="SchemeSection" Content="常规开关" Tag="Normal"
                                         IsChecked="True" Checked="OnSectionTabChecked"
                                         Style="{StaticResource ModeTabStyle}"/>
                            <RadioButton Grid.Column="1" GroupName="SchemeSection" Content="轮转开关" Tag="Rotate"
                                         Checked="OnSectionTabChecked"
                                         Style="{StaticResource ModeTabStyle}"/>
                            <RadioButton Grid.Column="2" GroupName="SchemeSection" Content="双宏开关" Tag="Dual"
                                         Checked="OnSectionTabChecked"
                                         Style="{StaticResource ModeTabStyle}"/>
                        </Grid>
                    </Border>

                    <!-- 添加按钮（任一选择态下禁用并提示）-->
                    <Button DockPanel.Dock="Top" Height="30" Margin="0,0,0,8"
                            Command="{Binding StartPickingCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="Content" Value="＋ 添加连发键"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PickingKind}" Value="AddScheme">
                                        <Setter Property="Content" Value="正在录入，点击左侧键鼠…"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PickingKind}" Value="SetMasterKey">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 选择态提示条 -->
                    <Border DockPanel.Dock="Top" Background="#8A5CF5" CornerRadius="3" Padding="8,5"
                            Margin="0,0,0,8"
                            Visibility="{Binding PickingPromptVisible}">
                        <TextBlock Foreground="White" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding PickingPromptText}"/>
                    </Border>

                    <!-- 方案列表 -->
                    <ListBox ItemsSource="{Binding SchemeRows}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                              ToolTip="启用 / 停用该连发键（双宏为整体启停）"/>
                                    <TextBlock Grid.Column="1" Text="{Binding KeyName}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeFg}"/>
                                    <TextBox Grid.Column="2" Width="40" Margin="0,0,2,0"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             FontSize="11" MaxLength="3"
                                             Text="{Binding IntervalEdit, UpdateSourceTrigger=LostFocus}"
                                             KeyDown="OnIntervalBoxKeyDown"
                                             ToolTip="连发间隔（毫秒，10~100），回车或点击别处生效，越界自动钳制"/>
                                    <TextBlock Grid.Column="3" Text="ms" VerticalAlignment="Center"
                                               Margin="0,0,4,0" FontSize="11" Opacity="0.7"
                                               Foreground="{DynamicResource ThemeFg}"/>
                                    <!-- 键位可视化开关（lucide eye / eye-off；仅控制悬浮层显示；
                                         样式与删除按钮统一（IconButtonStyle），全局总开关关闭时整体暗淡禁用 -->
                                    <Button Grid.Column="4" Width="22" Height="20" Padding="0"
                                            Command="{Binding ToggleVisualCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            IsEnabled="{Binding DataContext.GlobalVisualEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="键位可视化开关：按键触发时是否在屏幕右下角显示键帽">
                                        <Grid Cursor="Hand" Background="Transparent">
                                            <Path Stroke="{DynamicResource ThemeFg}"
                                                  StrokeThickness="1.8" Fill="Transparent"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="15" Height="15" Stretch="Uniform">
                                                <!-- Data / Opacity 全部走 Style Setter：本地值会压过 DataTrigger -->
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource EyeIconPath}"/>
                                                        <Setter Property="Opacity" Value="0.75"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VisualEnabled}" Value="False">
                                                                <Setter Property="Data" Value="{StaticResource EyeOffIconPath}"/>
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                            </DataTrigger>
                                                            <!-- 全局可视化关闭：统一暗淡（不改各键开关状态，恢复后延续） -->
                                                            <DataTrigger Binding="{Binding DataContext.GlobalVisualEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                <Setter Property="Opacity" Value="0.25"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="5" Content="✕" Width="22" Height="20"
                                            Padding="0" FontSize="10"
                                            Command="{Binding DeleteCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="删除该连发键"/>
                                    <!-- 第二行：双宏辅键名（占位对齐，无勾选 / 无删除；与主键共为一个整体） -->
                                    <Grid Grid.Row="1" Visibility="{Binding IsDual, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="12"
                                                   Foreground="{DynamicResource ThemeFg}" Opacity="0.75">
                                            <Run Text="⇄ " FontWeight="SemiBold"/><Run Text="{Binding SecondKeyName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
