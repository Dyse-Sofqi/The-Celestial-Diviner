<Window x:Class="TheCelestialDiviner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TheCelestialDiviner.Helpers"
        Title="衍天高手 The Celestial Diviner v1.0"
        Width="1000" Height="600" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBg}"
        Closing="OnClosing">

    <Window.Resources>
        <conv:BoolToDisabledOpacityConverter x:Key="BoolToOpacity"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToLogHeightConverter x:Key="BoolToLogHeight"/>
        <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>

        <!-- 输入源控件模板：图标 + 名称 + 目标键小字；占位空白透明 -->
        <DataTemplate x:Key="SourceButtonTemplate">
            <Border x:Name="Root"
                    Background="{Binding Background}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Margin="2"
                    Opacity="{Binding GloballyDisabled, Converter={StaticResource BoolToOpacity}}">
                <Border.InputBindings>
                    <!-- 左键单击：编辑方案；右键菜单在 Border.ContextMenu -->
                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SourceClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="编辑方案"
                                  Command="{Binding DataContext.EditSchemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="启用/停用方案"
                                  Command="{Binding DataContext.ToggleSchemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="清空方案"
                                  Command="{Binding DataContext.ClearSchemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Icon}" FontSize="11" HorizontalAlignment="Center"
                               Foreground="{Binding Foreground}"
                               Visibility="{Binding Icon, Converter={StaticResource EmptyToCollapsed}}"/>
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{Binding Foreground}"/>
                    <TextBlock Text="{Binding TargetsSummary}" FontSize="9"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding Foreground}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSpacer}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="Transparent"/>
                    <Setter TargetName="Root" Property="BorderBrush" Value="Transparent"/>
                    <Setter TargetName="Root" Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ===== 标题栏（40px）===== -->
        <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource ThemePanel}">
            <TextBlock Text="衍天高手 The Celestial Diviner v1.0"
                       FontSize="14" FontWeight="Bold" Margin="12,0"
                       Foreground="{DynamicResource ThemeFg}"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ===== 顶部状态栏（44px）===== -->
        <Border DockPanel.Dock="Top" Height="44" Background="{DynamicResource ThemePanel}">
            <DockPanel Margin="12,0">
                <Button DockPanel.Dock="Right" Content="全部停止 (Ctrl+点击)"
                        Style="{StaticResource IconButtonStyle}"
                        PreviewMouseLeftButtonDown="OnStopAllButtonDown"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding TimerStatusText}"/>
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding PermissionText}"/>
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding HookStatusText}"/>
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding MasterStateText}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 全局停用横幅（32px，仅停用时显示）===== -->
        <Border DockPanel.Dock="Top" Height="32" Background="#FFB300"
                Visibility="{Binding ShowDisabledBanner, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="⏸ 全局停用中 — 按 [全局开关键] 恢复"
                       Foreground="#1F1F1F" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- ===== 鼠标区（64px）===== -->
        <Border DockPanel.Dock="Top" Height="64" Padding="10,6">
            <ItemsControl ItemsSource="{Binding MouseButtons}"
                          ItemTemplate="{StaticResource SourceButtonTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <!-- ===== 底部控制栏（36px）===== -->
        <Border DockPanel.Dock="Bottom" Height="36" Background="{DynamicResource ThemePanel}">
            <DockPanel Margin="10,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding HintText}"
                           Foreground="{DynamicResource ThemeFg}" Opacity="0.6"
                           FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="导入配置" Style="{StaticResource IconButtonStyle}"
                            Padding="8,3" Margin="0,0,8,0" Command="{Binding ImportCommand}"/>
                    <Button Content="导出配置" Style="{StaticResource IconButtonStyle}"
                            Padding="8,3" Margin="0,0,8,0" Command="{Binding ExportCommand}"/>
                    <Button Content="设置全局开关" Style="{StaticResource IconButtonStyle}"
                            Padding="8,3" Command="{Binding SetGlobalSwitchCommand}"/>
                    <Button x:Name="LogToggleButton" Content="日志 ▲"
                            Style="{StaticResource IconButtonStyle}"
                            Padding="8,3" Margin="12,0,0,0"
                            Command="{Binding ToggleLogCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 日志面板（可折叠，展开 120px）===== -->
        <Border DockPanel.Dock="Bottom" Height="{Binding LogsExpanded, Converter={StaticResource BoolToLogHeight}}"
                Background="{DynamicResource ThemePanel}" ClipToBounds="True">
            <ListBox x:Name="LogList" ItemsSource="{Binding Logs}"
                     FontSize="11" BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource ThemeFg}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Border>

        <!-- ===== 键盘区（自适应填充）===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,4">
            <ItemsControl ItemsSource="{Binding KeyboardRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding}"
                                      ItemTemplate="{StaticResource SourceButtonTemplate}"
                                      Margin="0,2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
