<Window x:Class="TheCelestialDiviner.Views.KeycapOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeycapOverlay" ShowInTaskbar="False" ShowActivated="False"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Width="560" Height="100" Topmost="True"
        Focusable="False" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <!--
        键帽可视化悬浮层：置顶 + 不抢焦点。穿透由 Win32 WS_EX_TRANSPARENT 控制。
        注意：根元素不可设 IsHitTestVisible=False，否则调整模式无法拖拽。
        尺寸 560×100（单行约 7 键）：分层窗口每帧走 UpdateLayeredWindow 软件上传，
        呈现成本与表面积成正比——前台最大化游戏争抢 DWM 时 940×180 表面会拖出秒级停滞，
        缩小窗口是当前架构下最直接的降载手段（超出宽度的键帽本就不显示）。
    -->
    <!-- 键帽容器：单行水平排列（右下角对齐；超出一行宽度的键帽不再换行，直接不显示） -->
    <StackPanel x:Name="Root" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
</Window>
