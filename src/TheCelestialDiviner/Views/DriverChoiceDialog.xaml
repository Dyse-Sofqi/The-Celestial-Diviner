<Window x:Class="TheCelestialDiviner.Views.DriverChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择键盘注入驱动 — 衍天高手"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Border Padding="22,18,22,16">
        <StackPanel>
            <TextBlock Text="选择键盘注入驱动" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="SubtitleText" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                       Margin="0,0,0,14"/>

            <Border BorderThickness="1" CornerRadius="4" Padding="12,10"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <StackPanel>
                    <TextBlock Text="系统检测" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock x:Name="EnvText" FontSize="12" TextWrapping="Wrap" LineHeight="19"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="RecommendTitle" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,4"/>
            <TextBlock x:Name="ReasonText" FontSize="12" TextWrapping="Wrap" LineHeight="19"/>
            <TextBlock x:Name="WarningText" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                       Margin="0,8,0,0" Foreground="#B26A00"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="PrimaryButton" Padding="14,6" MinWidth="150" IsDefault="True" Click="OnPrimary"/>
                <Button x:Name="AlternativeButton" Padding="14,6" MinWidth="130" Margin="8,0,0,0" Click="OnAlternative"/>
                <Button x:Name="SkipButton" Content="暂不（普通模式）" Padding="14,6" MinWidth="130"
                        Margin="8,0,0,0" IsCancel="True" Click="OnSkip"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
