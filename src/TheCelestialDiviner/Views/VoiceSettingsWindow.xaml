<Window x:Class="TheCelestialDiviner.Views.VoiceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="语音设置" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeFg}" FontSize="12"
        UseLayoutRounding="True">
    <!-- 模态语音设置：三行（开启 / 关闭 / 方案切换），每行可导入自定义音频、试听、重置回默认。
         行内容由 code-behind 构建（三行结构一致，避免 XAML 重复与额外行 VM）。 -->
    <Border Padding="18,16,18,14">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,14"
                       Text="为总开关开启 / 关闭与方案切换设置自定义提示音（支持 mp3 / wav / m4a / aac / wma）。导入的音频会复制到程序数据目录并立即生效，原文件删除后仍可使用；可随时试听或重置回默认。"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="关闭" Width="78" Height="28"
                        Style="{StaticResource IconButtonStyle}" Click="OnCloseClick"/>
            </StackPanel>
            <StackPanel x:Name="RowsPanel"/>
        </DockPanel>
    </Border>
</Window>
